---
import ThemeToggle from './ThemeToggle';
import LanguagePicker from './LanguagePicker';
import NavLink from './NavLink';
import NavContact from './NavContact';
import MobileMenu from './MobileMenu';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="fixed top-0 left-0 w-full z-50 bg-light-bg/80 dark:bg-navy-900/80 backdrop-blur-md border-b border-gray-200 dark:border-white/10 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <div class="flex-shrink-0">
                <a href={localizePath(lang, '/')} class="text-2xl font-bold text-gray-900 dark:text-white transition-colors">
                    yainier<span class="text-light-primary dark:text-neon-cyan">.com</span>
                </a>
            </div>
            <nav class="hidden md:block" aria-label="Main">
                <div class="ml-10 flex items-baseline space-x-6">
                    <NavLink href={localizePath(lang, '/')} icon="home" text={t('nav.home')} />
                    <NavLink href={localizePath(lang, '/about')} icon="about" text={t('nav.about')} />
                    <NavLink href={localizePath(lang, '/projects')} icon="projects" text={t('nav.projects')} />
                    <NavLink href={localizePath(lang, '/blog')} icon="blog" text={t('nav.blog')} />
                    <NavLink href={localizePath(lang, '/recommended')} icon="recommended" text={t('nav.recommended')} />
                    <NavContact client:idle icon="contact" text={t('nav.contact')} />
                    <div class="ml-4">
                        <NavLink href="/resume.pdf" icon="download" text={t('nav.resume')} isButton={true} />
                    </div>
                </div>
            </nav>
            <div class="hidden md:flex items-center gap-4">
                <LanguagePicker currentLang={lang} pathname={Astro.url.pathname} />
                <ThemeToggle client:idle label={t('theme.toggle')} />
            </div>

            <MobileMenu 
                client:idle 
                lang={lang} 
                pathname={Astro.url.pathname} 
                trans={{
                    home: t('nav.home'),
                    about: t('nav.about'),
                    projects: t('nav.projects'),
                    blog: t('nav.blog'),
                    recommended: t('nav.recommended'),
                    contact: t('nav.contact'),
                    resume: t('nav.resume'),
                    settings: t('nav.settings'),
                    toggle: t('menu.toggle'),
                    close: t('menu.close'),
                    theme: t('theme.toggle')
                }} 
            />
        </div>
    </div>
</header>
