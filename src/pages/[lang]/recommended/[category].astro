---
import { getCollection } from 'astro:content';
import RecommendedCategoryPage from '../../../views/RecommendedCategoryPage.astro';
import { nonDefaultLangPaths, type Lang } from '../../../i18n/utils';

export async function getStaticPaths() {
    const categories = await getCollection('reco_categories');
    return nonDefaultLangPaths().flatMap(({ params: { lang } }) =>
        categories
            .filter((category) => category.id.startsWith(`${lang}/`))
            .map((category) => {
                const categorySlug = category.id.split('/').pop()!.replace('.md', '');
                return { params: { lang, category: categorySlug }, props: { category, categorySlug } };
            })
    );
}

const lang = Astro.params.lang as Lang;
const { category, categorySlug } = Astro.props;
---

<RecommendedCategoryPage lang={lang} category={category} categorySlug={categorySlug} />
