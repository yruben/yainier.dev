---
import { getCollection } from 'astro:content';
import BlogPostPage from '../../../views/BlogPostPage.astro';
import { nonDefaultLangPaths, stripLang, type Lang } from '../../../i18n/utils';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    return nonDefaultLangPaths().flatMap(({ params: { lang } }) =>
        posts
            .filter((post) => post.id.startsWith(`${lang}/`))
            .map((post) => ({
                params: { lang, slug: stripLang(post.slug) },
                props: { post },
            }))
    );
}

const lang = Astro.params.lang as Lang;
const { post } = Astro.props;
---

<BlogPostPage lang={lang} post={post} />
